<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.library</groupId>
    <artifactId>campus-library-manager</artifactId>
    <version>1.0-SNAPSHOT</version>

    <packaging>war</packaging>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring.version>6.2.19</spring.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok.version>1.18.42</lombok.version>
    </properties>

    <dependencies>

        <!-- Spring MVC -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <version>${spring.version}</version>
        </dependency>

        <!-- Servlet API: provided by Tomcat -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.0.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- JSP API -->
        <dependency>
            <groupId>jakarta.servlet.jsp</groupId>
            <artifactId>jakarta.servlet.jsp-api</artifactId>
            <version>3.1.1</version>
            <scope>provided</scope>
        </dependency>

        <!-- JSTL API -->
        <dependency>
            <groupId>jakarta.servlet.jsp.jstl</groupId>
            <artifactId>jakarta.servlet.jsp.jstl-api</artifactId>
            <version>3.0.2</version>
        </dependency>

        <!-- JSTL Implementation -->
        <dependency>
            <groupId>org.glassfish.web</groupId>
            <artifactId>jakarta.servlet.jsp.jstl</artifactId>
            <version>3.0.1</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- MapStruct -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>

    </dependencies>

    <build>
        <finalName>campus-library</finalName>  <!--campus-library.war-->

        <plugins>

            <!-- Java Compiler + Annotation Processors -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>   <!--This plugin is responsible for compiling Java code.-->
                <artifactId>maven-compiler-plugin</artifactId>  <!--The name of Plugin.-->
                <version>3.14.1</version>

                <configuration> <!--This section specifies the Plugin specific settings.
                                   That is, we tell the Compiler Plugin how to compile.-->

                    <release>21</release>  <!--This means that the project's Java code is compiled with the Java 21 standard.-->
                    <!--release doesn't just specify the compilation version; it also aligns the usable APIs and output Bytecode version with the target version.-->

                    <!--
                    <maven.compiler.release>21</maven.compiler.release>

                    We had specified the same value in the properties section.
                    So why is it here again?
                    Because in this section we are giving the setting directly to the Compiler Plugin.
                    For simple projects, it is usually enough to define the Property and use it; but in this setting,
                     we have explicitly specified the release inside the Plugin.
                    -->


                    <annotationProcessorPaths> <!--An Annotation Processor is a tool that checks specific annotations during compilation and can generate code.-->
                        <!--
                        Java Source
                            ↓
                        Compiler
                            ↓
                        Annotation Processor
                            ↓
                        Generated Code
                            ↓
                        Compiled Classes
                        -->
                        <path>
                            <groupId>org.projectlombok</groupId>  <!--This setting tells Maven to consider Lombok as the Annotation Processor at compile time.-->
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>

                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>

                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>0.2.0</version>
                        </path>

                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- WAR Packaging -->
            <!--This plugin is used to package the project in WAR(Web Application Archive) format.-->

            <!--
            Simple WAR structure:

            campus-library.war
            │
            ├── WEB-INF
            │   ├── web.xml
            │   ├── classes
            │   └── lib
            │
            ├── JSP Files
            └── Other Web Resources

            In our project, JSPs, Spring configurations, and Java classes are placed inside the WAR.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
            </plugin>

        </plugins>
    </build>

</project>
